#!/usr/bin/python3
# -*- coding: utf-8 -*-

"""
set-ue-mode — configure Quectel modem for MBIM or QMI
Supports RM500Q-GL, RM520N-GL, RG255C-GL
Requires: pyserial, usb_modeswitch, modprobe access
"""

import os
import sys
import time
import serial
import argparse

# --- Color profiles ---
COLOR_SCHEMES = {
    "day": {
        "info": "\033[94m",   # blue
        "ok": "\033[92m",     # green
        "warn": "\033[93m",   # yellow
        "error": "\033[91m",  # red
        "reset": "\033[0m",
    },
    "night": {
        "info": "\033[96m",   # cyan
        "ok": "\033[97m",     # white
        "warn": "\033[95m",   # magenta
        "error": "\033[91m",  # red
        "reset": "\033[0m",
    }
}


def color_print(msg, level="info", scheme="day"):
    c = COLOR_SCHEMES[scheme]
    print(f"{c[level]}{msg}{c['reset']}")


def send_at(port, cmd, delay=0.3, scheme="day"):
    port.write(f"{cmd}\r".encode())
    time.sleep(delay)
    lines = []
    while port.in_waiting > 0:
        line = port.readline().decode(errors="ignore").strip()
        if line:
            lines.append(line)
    color_print(f"↪ {cmd.strip()} → {lines}", "info", scheme)
    return lines


def main():
    parser = argparse.ArgumentParser(description="Configure Quectel modem MBIM/QMI mode")
    parser.add_argument("--mode", choices=["mbim", "qmi"], required=True, help="Select USB network mode")
    parser.add_argument("--night", action="store_true", help="Night mode (light text for dark terminals)")
    args = parser.parse_args()

    scheme = "night" if args.night else "day"

    color_print("🔧 Initializing set-ue-mode script", "info", scheme)

    dev = "/dev/ttyUSB2"
    if not os.path.exists(dev):
        color_print(f"❌ Device {dev} not found — is modem powered?", "error", scheme)
        sys.exit(1)

    try:
        port = serial.Serial(dev, 460800, timeout=2)
    except Exception as e:
        color_print(f"❌ Cannot open {dev}: {e}", "error", scheme)
        sys.exit(1)

    color_print("🔎 Checking current usbnet mode...", "info", scheme)
    send_at(port, 'AT+QCFG="usbnet"', scheme=scheme)

    if args.mode == "mbim":
        color_print("🌐 Switching to MBIM mode...", "info", scheme)
        os.system("modprobe -r qmi_wwan 2>/dev/null; modprobe cdc_mbim")
        send_at(port, 'AT+QCFG="usbnet",2', scheme=scheme)
    else:
        color_print("📡 Switching to QMI mode...", "info", scheme)
        os.system("modprobe -r cdc_mbim 2>/dev/null; modprobe qmi_wwan")
        send_at(port, 'AT+QCFG="usbnet",0', scheme=scheme)

    color_print("🔁 Rebooting modem...", "warn", scheme)
    send_at(port, "AT+CFUN=1,1", delay=0.1, scheme=scheme)

    port.close()
    color_print("🧠 Triggering hardware reset...", "warn", scheme)
    os.system("hard-reset-ue || true")

    color_print("✅ Done — modem should reappear in ~10s", "ok", scheme)


if __name__ == "__main__":
    main()